# =============================================================================
# Octane Ajax — every environment variable the code actually reads.
#
# This file is the contract. 2026-07-25 audit, M9: 67 vars were read across
# src/ and scripts/ and 31 of them appeared nowhere here — including
# AUTOPILOT_DISABLED, the kill switch for the hourly autopilot. You could not
# discover your own kill switch from the file whose job is to list it. Four
# more were documented but no longer read by anything.
#
# Rules for this file, so it can't drift again:
#   * Every `process.env.X` in src/ or scripts/ appears here, commented or not.
#   * Uncommented + empty = you are expected to set it.
#   * Commented out = optional; the value shown IS the code's default.
#   * Delete an entry the moment its last reader is deleted.
#
# Verify with:
#   grep -rhoE 'process\.env\.[A-Z0-9_]+' src scripts | sed 's/.*\.//' | sort -u
# (plus the dynamic LLM_<TASK>_* pair built in lib/llm/providers.ts)
#
# NODE_ENV is set by Next/Vercel, never by you.
# =============================================================================

# =============================================================================
# Octane inter-system HMAC (shared with Engineer hub and sibling spokes)
# =============================================================================
OCTANE_SHARED_SECRET=your-ultra-secure-64-character-hex-secret-here

# =============================================================================
# Supabase (required)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — npm run check:demo live auth + authenticated RLS (existing user)
DEMO_TEST_EMAIL=
DEMO_TEST_PASSWORD=

# =============================================================================
# OpenAI (required for Nova, Forge, Pixel LLM, and artwork)
# =============================================================================
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini    # model the Review Gate uses to SEE the mockup
# VISION_QA_MODEL=gpt-4o-mini        # mockup vision QA (lib/review/mockup-vision-qa.ts)

# =============================================================================
# Etsy OAuth (required for auto-publishing)
# =============================================================================
ETSY_CLIENT_ID=                    # Etsy app "Keystring" (also the OAuth client_id)
ETSY_CLIENT_SECRET=                # Etsy app "Shared secret" — REQUIRED: every Etsy v3 call sends x-api-key as "keystring:shared_secret"
ETSY_WEBHOOK_SECRET=               # verifies incoming personalized-order webhooks
# Revenue/orders analytics (opt-in). Set to "true" ONLY after your Etsy app lists
# the transactions_r scope in the Etsy developer portal, then reconnect Etsy.
# Leave unset for the core connection (drafts + views/favorites analytics);
# revenue/orders are simply skipped until enabled.
# ETSY_ENABLE_TRANSACTIONS_SCOPE=true
# Share & Save trackable shop URL — every link the app shares publicly uses this
# domain so qualifying orders earn reduced Etsy fees. Defaults to the operator's
# share domain when unset (GotchaDayGoods since the 2026-07-03 rebrand).
# ETSY_SHARE_SAVE_URL=https://gotchadaygoods.etsy.com
NEXT_PUBLIC_APP_URL=https://octane-ajax.vercel.app
# Public origin used in generated affiliate/guide links. WRONG VALUE = every
# affiliate link points at the vercel.app host instead of your custom domain.
# PUBLIC_SITE_URL=https://octane-ajax.vercel.app
# Shop URL social posts link to (lib/social/auto-poster.ts).
# SHOP_SHARE_URL=https://gotchadaygoods.etsy.com

# =============================================================================
# Printify — print-on-demand fulfillment (server-side only)
# =============================================================================
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# PRINTIFY_TIMEOUT_MS=90000          # per-call hard timeout (audit H11)

# =============================================================================
# Social publishing (Ayrshare) — ONE key posts to all linked networks.
# Sign up at ayrshare.com, link your socials there, add the key here.
# Enables "Publish now" on Pixel's promo packages (TikTok queue panel).
# =============================================================================
AYRSHARE_API_KEY=
# AYRSHARE_PROFILE_KEY=              # Business-plan sub-profile to post as (single profile: leave unset)
# AYRSHARE_API_URL=https://api.ayrshare.com/api/post
# AYRSHARE_ANALYTICS_URL=https://api.ayrshare.com/api/analytics/post
# AYRSHARE_MAX_PACK=true             # send the full media pack per post instead of the trimmed set
# SOCIAL_PLATFORMS=instagram,facebook,pinterest   # where posts go (comma-separated)
# SOCIAL_PLATFORM_CAPS=instagram:2,pinterest:4    # max posts per platform per day
# SOCIAL_POSTING_WINDOW=13-23        # UTC hour range posts are allowed in
# SOCIAL_POSTING_TZ=America/Chicago  # timezone the window is evaluated in
# SOCIAL_VIDEO_AUTOPOST=true         # opt-in: on approve, render a 9:16 clip and auto-post it (needs AYRSHARE_API_KEY). Default OFF = Etsy listing video only.
# SOCIAL_VIDEO_RENDER_VERTICAL=true  # render the social clip vertical rather than reusing the listing video
# SOCIAL_VIDEO_FRESH_AFTER=72h       # how long a rendered clip counts as fresh enough to post
# SOCIAL_TIKTOK_DRAFTS=true          # push TikTok posts as drafts instead of publishing

# =============================================================================
# Video rendering (optional) — animates product mockups into 9:16 MP4s via fal.ai
# Get a key at fal.ai (pay-as-you-go). Dormant until set; ~$0.30 per 10s clip.
# =============================================================================
FAL_KEY=                            # fal.ai API key (format "id:secret")
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video  # image-to-video model override

# =============================================================================
# Artwork generation
# =============================================================================
IMAGE_GENERATOR_PROVIDER=demo       # "openai" in production for live gpt-image-1
# IMAGE_GENERATOR_MODEL=gpt-image-1
# IMAGE_GENERATOR_TRANSPARENT_MODEL=gpt-image-1   # model used when a transparent PNG is required
# IMAGE_GENERATION_TIMEOUT_MS=45000

# =============================================================================
# Multi-model router (optional — each falls back to OpenAI when its key is absent)
# =============================================================================
ANTHROPIC_API_KEY=                 # Nova ideation + War Room strategy (Claude)
GEMINI_API_KEY=                    # Pixel marketing copy (Gemini)
# GOOGLE_API_KEY=                   # accepted as an alias for GEMINI_API_KEY; without either, Google-routed tasks silently fall back
# Per-task overrides. TASK = IDEATION | STRATEGY | MARKETING | SCORING | LISTING
# (read dynamically as LLM_<TASK>_PROVIDER / LLM_<TASK>_MODEL):
#   LLM_IDEATION_PROVIDER=anthropic
#   LLM_IDEATION_MODEL=claude-sonnet-4-6
#   LLM_MARKETING_MODEL=gemini-2.0-flash
# Fallback models when a task's provider is unavailable:
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM_FALLBACK_GOOGLE_MODEL=gemini-2.0-flash
# TREND_RESEARCH_MODEL=gemini-2.0-flash   # Pixel's trend research pass
# Bias which products Forge makes. Catalog keys or plain words, comma-separated.
# Leave unset for an auto mix (apparel/mugs for slogans, posters for wall-art).
# FORGE_PRODUCT_FOCUS=TEE_UNISEX,SWEATSHIRT_CREWNECK,MUG_11OZ

# =============================================================================
# Nova market research (optional)
# =============================================================================
SERPAPI_API_KEY=                   # Google Trends demand signals
YOUTUBE_API_KEY=                   # YouTube buzz signals

# =============================================================================
# Affiliate links / guides (optional)
# =============================================================================
# AFFILIATE_AMAZON_TAG=             # Amazon Associates tag appended at redirect time
# AFFILIATE_AWIN_ETSY_ID=           # Awin publisher id for Etsy affiliate links

# =============================================================================
# Automation / cron
# =============================================================================
CRON_SECRET=                       # Bearer token Vercel Cron sends to /api/cron/*
OPERATOR_EMAIL=                    # operator account email (cron resolves the user; also the operator gate)
AUTOPILOT_DISABLED=                # true = kill switch: hourly autopilot exits immediately (incl. maintenance)
AUTOPILOT_LISTING_FREEZE_UNTIL=    # ISO date: automated listing writes paused until then ("" lifts; default in lib/ajax/listing-freeze.ts)
AUTOPILOT_AUTONOMOUS_REVIEW=       # false = hard human Review Gate: AI grades but never approves/publishes (default: autonomous)
AI_REVIEWER_AUTONOMOUS=            # true = /api/ajax/review/ai-review may act on its verdict (manual route only)
AUTOPILOT_NOVA_FREE_RUN=           # true = Nova may invent products beyond the operator seed queue (default: seeds only)
# AUTOPILOT_TARGET_LISTINGS=35      # stop auto-producing at this many active listings
# AI_REVIEWER_APPROVE_THRESHOLD=85  # score at/above which the AI reviewer may approve
# AI_REVIEWER_REJECT_THRESHOLD=60   # score below which it rejects outright
VIDEO_DAILY_RENDER_CAP=            # max paid fal renders per UTC day (default 8)

# =============================================================================
# Automated takedowns (autopilot/takedown.ts) — retiring dead listings
# =============================================================================
# TAKEDOWN_MIN_AGE_DAYS=30          # never retire a listing younger than this
# TAKEDOWN_WEAK_VIEWS=20            # "weak" view count when the shop is at capacity
# TAKEDOWN_DEAD_AGE_DAYS=45         # age at which a no-traffic listing counts as dead
# TAKEDOWN_DEAD_VIEWS=5             # view count that counts as dead at that age
